{% doc %}
  @prompt
    Create a custom font loader block that adds custom font files to the site's head section with options to upload font files and configure font-family names

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-font-display-{{ ai_gen_id }} {
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-font-display__heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font_family }}, sans-serif;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .ai-font-display__body-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font_family }}, sans-serif;
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.body_color }};
    margin: 0 0 24px 0;
    line-height: 1.5;
  }

  .ai-font-display__accent-{{ ai_gen_id }} {
    font-family: {{ block.settings.accent_font_family }}, sans-serif;
    font-size: {{ block.settings.accent_size }}px;
    color: {{ block.settings.accent_color }};
    margin: 0;line-height: 1.3;
  }

  .ai-font-display__css-output-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 16px;
    margin-top: 24px;
    font-family: monospace;
    font-size: 14px;
    white-space: pre-wrap;
    overflow-x: auto;
  }

  .ai-font-display__instructions-{{ ai_gen_id }} {
    background-color: #e7f3ff;
    border-left: 4px solid #0066cc;
    padding: 16px;
    margin-top: 16px;
    font-size: 14px;
    line-height: 1.4;
  }

  .ai-font-display__font-info-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  .ai-font-display__font-card-{{ ai_gen_id }} {
    background-color: #f9f9f9;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 16px;
  }

  .ai-font-display__font-name-{{ ai_gen_id }} {
    font-weight: bold;
    margin-bottom: 8px;
    color: #333;
  }

  .ai-font-display__font-sample-{{ ai_gen_id }} {
    margin-bottom: 8px;
  }

  .ai-font-display__font-details-{{ ai_gen_id }} {
    font-size: 12px;
    color: #666;}

  @media screen and (max-width: 749px) {
    .ai-font-display-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.7 }}px;
    }
    .ai-font-display__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
    
    .ai-font-display__css-output-{{ ai_gen_id }} {
      font-size: 12px;
    }
  }
{% endstyle %}

<div class="ai-font-display-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_preview %}
    <div class="ai-font-display__preview-{{ ai_gen_id }}">
      {% if block.settings.heading_text != blank %}
        <h2 class="ai-font-display__heading-{{ ai_gen_id }}">{{ block.settings.heading_text }}</h2>
      {% endif %}
      
      {% if block.settings.body_text != blank %}
        <p class="ai-font-display__body-{{ ai_gen_id }}">{{ block.settings.body_text }}</p>
      {% endif %}
      
      {% if block.settings.accent_text != blank %}
        <p class="ai-font-display__accent-{{ ai_gen_id }}">{{ block.settings.accent_text }}</p>
      {% endif %}</div>
  {% endif %}

  {% if block.settings.show_font_info %}
    <div class="ai-font-display__font-info-{{ ai_gen_id }}">
      {% if block.settings.heading_font_family != blank %}
        <div class="ai-font-display__font-card-{{ ai_gen_id }}">
          <div class="ai-font-display__font-name-{{ ai_gen_id }}">Heading Font</div>
          <div class="ai-font-display__font-sample-{{ ai_gen_id }}" style="font-family: {{ block.settings.heading_font_family }}, sans-serif;">
            The quick brown fox jumps over the lazy dog
          </div><div class="ai-font-display__font-details-{{ ai_gen_id }}">
            Family: {{ block.settings.heading_font_family }}<br>
            Size: {{ block.settings.heading_size }}px
          </div>
        </div>
      {% endif %}

      {% if block.settings.body_font_family != blank %}
        <div class="ai-font-display__font-card-{{ ai_gen_id }}">
          <div class="ai-font-display__font-name-{{ ai_gen_id }}">Body Font</div>
          <div class="ai-font-display__font-sample-{{ ai_gen_id }}" style="font-family: {{ block.settings.body_font_family }}, sans-serif;">
            The quick brown fox jumps over the lazy dog
          </div>
          <div class="ai-font-display__font-details-{{ ai_gen_id }}">
            Family: {{ block.settings.body_font_family }}<br>
            Size: {{ block.settings.body_size }}px
          </div>
        </div>
      {% endif %}

      {% if block.settings.accent_font_family != blank %}
        <div class="ai-font-display__font-card-{{ ai_gen_id }}">
          <div class="ai-font-display__font-name-{{ ai_gen_id }}">Accent Font</div>
          <div class="ai-font-display__font-sample-{{ ai_gen_id }}" style="font-family: {{ block.settings.accent_font_family }}, sans-serif;">
            The quick brown fox jumps over the lazy dog
          </div>
          <div class="ai-font-display__font-details-{{ ai_gen_id }}">
            Family: {{ block.settings.accent_font_family }}<br>
            Size: {{ block.settings.accent_size }}px
          </div>
        </div>
      {% endif %}
    </div>
  {% endif %}

  {% if block.settings.show_css_output %}
    <div class="ai-font-display__instructions-{{ ai_gen_id }}">
      <strong>Instructions:</strong> To use custom fonts, upload your font files to your theme's assets folder and add the @font-face declarations to your theme's CSS. Then use the font-family names configured below.
    </div>

    <div class="ai-font-display__css-output-{{ ai_gen_id }}">/* Copy this CSS to your theme */

{% if block.settings.heading_font_family != blank %}@font-face {
  font-family: '{{ block.settings.heading_font_family }}';
  src: url('{{ 'your-heading-font.woff2' | asset_url }}') format('woff2'),
       url('{{ 'your-heading-font.woff' | asset_url }}') format('woff');
  font-weight: normal;
  font-style: normal;font-display: swap;
}

.heading-custom {
  font-family: '{{ block.settings.heading_font_family }}', sans-serif;
}
{% endif %}
{% if block.settings.body_font_family != blank %}@font-face {
  font-family: '{{ block.settings.body_font_family }}';
  src: url('{{ 'your-body-font.woff2' | asset_url }}') format('woff2'),
       url('{{ 'your-body-font.woff' | asset_url }}') format('woff');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

.body-custom {
  font-family: '{{ block.settings.body_font_family }}', sans-serif;
}
{% endif %}
{% if block.settings.accent_font_family != blank %}@font-face {
  font-family: '{{ block.settings.accent_font_family }}';
  src: url('{{ 'your-accent-font.woff2' | asset_url }}') format('woff2'),
       url('{{ 'your-accent-font.woff' | asset_url }}') format('woff');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

.accent-custom {
  font-family: '{{ block.settings.accent_font_family }}', sans-serif;
}
{% endif %}</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Custom font display",
  "settings": [
    {
      "type": "header",
      "content": "Font families"
    },
    {
      "type": "text",
      "id": "heading_font_family",
      "label": "Heading font family name",
      "default": "CustomHeadingFont"
    },
    {
      "type": "text",
      "id": "body_font_family",
      "label": "Body font family name",
      "default": "CustomBodyFont"
    },
    {
      "type": "text",
      "id": "accent_font_family",
      "label": "Accent font family name",
      "default": "CustomAccentFont"
    },
    {
      "type": "header",
      "content": "Preview text"
    },
    {
      "type": "checkbox",
      "id": "show_preview",
      "label": "Show font preview",
      "default": true
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading text",
      "default": "Custom Heading Font"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "This is how your custom body font will look when applied to paragraph text. You can see how readable it is at different sizes."
    },
    {
      "type": "text",
      "id": "accent_text",
      "label": "Accent text",
      "default": "Special Accent Text"
    },
    {
      "type": "header",
      "content": "Font sizes"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Body size",
      "default": 16
    },
    {
      "type": "range",
      "id": "accent_size",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Accent size",
      "default": 20
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Display options"
    },
    {
      "type": "checkbox",
      "id": "show_font_info",
      "label": "Show font information cards",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_css_output",
      "label": "Show CSS code output",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Custom font display"
    }
  ]
}
{% endschema %}