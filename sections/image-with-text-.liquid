{{ 'section-image-with-text.min.css' | asset_url | stylesheet_tag }}
<style>
  /* Ensure the image wrapper is a positioning context */
  .image-with-text__media, .media, .your-media-class,
  #image-with-text--{{ section.id }}, .img {
    position: relative;
  }

  .iwt-hotspots-overlay-{{ section.id }} {
    position: absolute;
    inset: 0;
    pointer-events: none; /* keep underlying section clickable */
  }

  .iwt-hotspot-{{ section.id }} {
    position: absolute;
    top: var(--y, 50%);
    left: var(--x, 50%);
    transform: translate(-50%, -50%);
    width: var(--size, 20px);
    height: var(--size, 20px);
    border-radius: 50%;
    background: var(--color, #ff3b30);
    border: 2px solid #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto; /* re-enable clicks for the hotspot */
    cursor: pointer;
    transition: transform .2s ease;
    box-shadow: 0 0 0 0 rgba(0,0,0,.15);
  }
  .iwt-hotspot-{{ section.id }}:hover { transform: translate(-50%, -50%) scale(1.07); }

  .iwt-hotspot-{{ section.id }}::after {
    content: '';
    position: absolute; inset: 0;
    border-radius: 50%;
    border: 2px solid var(--color, #ff3b30);
    animation: iwt-pulse-{{ section.id }} 2s infinite;
    opacity: .7; pointer-events: none;
  }
  @keyframes iwt-pulse-{{ section.id }} {
    0% { transform: scale(1); opacity: .7; }
    100% { transform: scale(1.8); opacity: 0; }
  }

  .iwt-hotspot-plus { color:#fff; font-size:12px; line-height:1; user-select:none; }

  .iwt-hotspot-label-{{ section.id }} {
    position: absolute;
    top: calc(var(--y, 50%) + 14px);
    left: var(--x, 50%);
    transform: translate(-50%, 0);
    background: rgba(0,0,0,.78);
    color:#fff; padding:6px 10px; border-radius:6px;
    font-size:12px; white-space:nowrap;
    opacity:0; transition:opacity .2s ease;
    pointer-events:none;
  }
  .iwt-hotspot-{{ section.id }}:hover + .iwt-hotspot-label-{{ section.id }},
  .iwt-hotspot-{{ section.id }}:focus + .iwt-hotspot-label-{{ section.id }} { opacity:1; }

  /* Mobile position overrides */
  @media (max-width: 767px) {
    .iwt-hotspot-{{ section.id }} {
      top: var(--y-mobile, var(--y, 50%));
      left: var(--x-mobile, var(--x, 50%));
    }
    .iwt-hotspot-label-{{ section.id }} {
      top: calc(var(--y-mobile, var(--y, 50%)) + 14px);
      left: var(--x-mobile, var(--x, 50%));
    }
  }
</style>

{% case section.settings.colors %}
  {% when 'white' %}
    {%- assign color_scheme = 'color-scheme--white' -%}
  {% when 'light' %}
    {%- assign color_scheme = 'color-scheme--light' -%}
  {% when 'accent' %}
    {%- assign color_scheme = 'color-scheme--accent' -%}
  {% when 'dark' %}
    {%- assign color_scheme = 'color-scheme--dark' -%}
{% endcase %}

{% assign animation_offset = 2 %}
{% assign animation_order = 1 %}

<div
  class="wrapper-spacing--v{% if section.settings.section-width == 'content' %} wrapper-spacing--h{% endif %} {{ color_scheme }} image-with-text__container{% unless section.settings.text_overlapping_image %} feature-row--no-overlapping{% else %} feature-row--overlapping{% endunless %}"
  data-wetheme-section-type="image--image-with-text" 
  data-wetheme-section-id="{{ section.id }}"
  style="--padding-section-top: {{ section.settings.section_padding_top }}px; --padding-section-bottom: {{ section.settings.section_padding_bottom }}px;"
>

  {% capture image_layout %}
    <div class="grid__item homepage-content--image homepage-content--{{ section.id }}{% if section.settings.text_overlapping_image %} overlapping-text{% else %} large--one-half{% endif %}{% if settings.animations_enabled %} kb-enabled{% endif %}{% if section.settings.section-width == 'content' %} block-radius{% endif %}">
      <div>
        {% if section.settings.image != blank %}
          <div id="image-with-text--{{ section.id }}" class="img">
            {% render 'responsive-image' with section.settings.image, sizes: '100vw', allow_stretch: true %}

            {%- comment -%} Hotspots overlay for image-with-text {%- endcomment -%}
            <div class="iwt-hotspots-overlay-{{ section.id }}">
              {%- for block in section.blocks -%}
                {%- if block.type == 'hotspot' -%}
                  {%- assign prod = nil -%}
                  {%- if block.settings.product != blank -%}
                    {%- assign prod = all_products[block.settings.product] -%}
                  {%- endif -%}

                  {%- if prod -%}
                    <button
                      {{ block.shopify_attributes }}
                      class="iwt-hotspot-{{ section.id }}"
                      type="button"
                      aria-label="{{ block.settings.aria_label | default: 'View product' | escape }}"
                      data-url="{{ prod.url }}"
                      style="
                        --x: {{ block.settings.desktop_x | default: 50 }}%;
                        --y: {{ block.settings.desktop_y | default: 50 }}%;
                        --x-mobile: {{ block.settings.mobile_x | default: block.settings.desktop_x | default: 50 }}%;
                        --y-mobile: {{ block.settings.mobile_y | default: block.settings.desktop_y | default: 50 }}%;
                        --size: {{ block.settings.size | default: 20 }}px;
                        --color: {{ block.settings.color | default: '#ff3b30' }};
                      "
                    >
                      <span class="iwt-hotspot-plus">+</span>
                    </button>

                    {%- if block.settings.label != blank -%}
                      <div class="iwt-hotspot-label-{{ section.id }}">{{ block.settings.label | escape }}</div>
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
            {#-- /overlay --#}

          </div>
        {% else %}
          <div id="image-with-text--{{ section.id }}" class="placeholder-background img">
            {{ 'collection-4' | placeholder_svg_tag: 'icon icon--placeholder' }}

            {%- comment -%} Hotspots overlay even in placeholder mode {%- endcomment -%}
            <div class="iwt-hotspots-overlay-{{ section.id }}">
              {%- for block in section.blocks -%}
                {%- if block.type == 'hotspot' -%}
                  {%- assign prod = nil -%}
                  {%- if block.settings.product != blank -%}
                    {%- assign prod = all_products[block.settings.product] -%}
                  {%- endif -%}

                  {%- if prod -%}
                    <button
                      {{ block.shopify_attributes }}
                      class="iwt-hotspot-{{ section.id }}"
                      type="button"
                      aria-label="{{ block.settings.aria_label | default: 'View product' | escape }}"
                      data-url="{{ prod.url }}"
                      style="
                        --x: {{ block.settings.desktop_x | default: 50 }}%;
                        --y: {{ block.settings.desktop_y | default: 50 }}%;
                        --x-mobile: {{ block.settings.mobile_x | default: block.settings.desktop_x | default: 50 }}%;
                        --y-mobile: {{ block.settings.mobile_y | default: block.settings.desktop_y | default: 50 }}%;
                        --size: {{ block.settings.size | default: 20 }}px;
                        --color: {{ block.settings.color | default: '#ff3b30' }};
                      "
                    >
                      <span class="iwt-hotspot-plus">+</span>
                    </button>

                    {%- if block.settings.label != blank -%}
                      <div class="iwt-hotspot-label-{{ section.id }}">{{ block.settings.label | escape }}</div>
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
            {#-- /overlay --#}
          </div>
        {% endif %}
      </div>
    </div>
  {% endcapture %}

  {% if section.settings.section-width == 'content' %}
    <div class="width--content">
  {% endif %}

    <div class="homepage-indiv-section-wrapper homepage-featured-content-wrapper feature-row__text--{{ section.settings.layout }} feature-row__text-alignment--{{ section.settings.text_alignment }}">
      {{ image_layout }}

      <div class="feature_row__image_wrapper{% if section.settings.text_overlapping_image %} homepage-featured-content-box{% else %} large--one-half{% endif %}">
        {% if section.settings.title != blank or section.settings.text != blank or section.settings.button_label != blank %}

          {% unless section.settings.text_overlapping_image %}
            <div class="no-overlap-content-box">
          {% endunless %}

            <div class="homepage-featured-content-box-inner{% if request.visual_preview_mode %} section-preview{% else %} show-on-scroll{% endif %}">

              {% if section.settings.title != blank %}
                <div class="sitewide--title-wrapper" data-animate data-animate-order="{{ animation_order | plus: animation_offset }}">
                  <h2 class="homepage-sections--title">{{ section.settings.title | escape }}</h2>
                </div>
                {% assign animation_order = animation_order | plus: 1 %}
              {% endif %}

              {% if section.settings.text != blank %}
                <div class="rte featured-row__subtext textarea text-link-animated richtext-block" data-animate data-animate-order="{{ animation_order | plus: animation_offset }}">
                  {{ section.settings.text }}
                </div>
                {% assign animation_order = animation_order | plus: 1 %}
              {% endif %}

              {% if section.settings.button_label != blank %}
                {% if section.settings.override_button_colors %}
                  {% render 'button-color-overrides' with
                    id: section.id,
                    style: section.settings.buttons_style,
                    text_color: section.settings.button_text_color,
                    background_color: section.settings.button_background_color
                  %}
                {% endif %}

                {% capture button_attr %}
                  data-animate
                  data-animate-order="{{ animation_order | plus: animation_offset }}"
                {% endcapture %}
                
                {% render 'dynamic-section-button' with
                  id: section.id,
                  link: section.settings.button_link,
                  label: section.settings.button_label,
                  style: section.settings.buttons_style,
                  div_classes: 'clearfix',
                  a_classes: 'homepage-featured-box-btn',
                  attributes: button_attr
                %}
              {% endif %}

            </div>

          {% unless section.settings.text_overlapping_image %}
            </div>
          {% endunless %}
        {% endif %}
      </div>
    </div>

  {% if section.settings.section-width == 'content' %}
    </div>
  {% endif %}

</div>

<script>
  (function() {
    var root = document.getElementById('shopify-section-{{ section.id }}') || document.currentScript.closest('section') || document.querySelector('[data-wetheme-section-id="{{ section.id }}"]');
    if (!root) return;
    root.querySelectorAll('.iwt-hotspot-{{ section.id }}').forEach(function(el) {
      el.addEventListener('click', function() {
        var url = el.getAttribute('data-url');
        if (url) window.location.href = url;
      });
      el.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          var url = el.getAttribute('data-url');
          if (url) window.location.href = url;
        }
      });
      el.setAttribute('tabindex', '0'); // keyboard focusable
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.image--image-with-text.name",
  "class": "image-with-text-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "t:all.Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:all.Image",
      "info": "t:sections.image--image-with-text.settings.image.info"
    },
    {
      "type": "radio",
      "id": "layout",
      "label": "t:all.image_position_desktop",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:all.Left"
        },
        {
          "value": "right",
          "label": "t:all.Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:all.Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:all.Heading",
      "default": "t:sections.image--image-with-text.name"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:all.Text",
      "default": "<p>Pair large text with an image to give focus to your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:all.Alignment_desktop",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "t:all.Left"
        },
        {
          "value": "center",
          "label": "t:all.Centered"
        },
        {
          "value": "right",
          "label": "t:all.Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "text_overlapping_image",
      "label": "t:sections.image--image-with-text.settings.text_overlapping_image.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:all.Button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:all.Button_link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:all.Button_label"
    },
    {
      "type": "select",
      "id": "buttons_style",
      "label": "t:all.button_style",
      "default": "filled",
      "options": [
        {
          "value": "filled",
          "label": "t:all.Filled"
        },
        {
          "value": "outlined",
          "label": "t:all.Outlined"
        },
        {
          "value": "underlined",
          "label": "t:all.underlined"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "override_button_colors",
      "label": "t:all.Button_color_override",
      "default": false,
      "info": "t:all.Button_color_override_info"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:all.Primary_color",
      "default": "#E68819"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:all.Secondary_color",
      "default": "#ffffff",
      "info": "t:all.Secondary_button_color_info"
    },
    {
      "type": "header",
      "content": "t:all.Layout"
    },
    {
      "type": "select",
      "id": "section-width",
      "label": "t:all.Width",
      "default": "full",
      "options": [
        {
          "value": "content",
          "label": "t:all.Content_width"
        },
        {
          "value": "full",
          "label": "t:all.Full_width"
        }
      ]
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "t:all.Spacing_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "t:all.px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "t:all.Spacing_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "t:all.px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:all.Color"
    },
    {
      "type": "select",
      "id": "colors",
      "label": "t:all.Color_scheme",
      "default": "light",
      "options": [
        {
          "value": "white",
          "label": "t:all.Default"
        },
        {
          "value": "light",
          "label": "t:all.First"
        },
        {
          "value": "accent",
          "label": "t:all.Second"
        },
        {
          "value": "dark",
          "label": "t:all.Third"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        { "type": "product", "id": "product", "label": "Linked product" },
        { "type": "text", "id": "label", "label": "Tooltip label", "default": "View product" },
        { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "View product" },

        { "type": "range", "id": "desktop_x", "label": "Desktop X (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "desktop_y", "label": "Desktop Y (%)", "min": 0, "max": 100, "step": 1, "default": 50 },

        { "type": "range", "id": "mobile_x", "label": "Mobile X (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "mobile_y", "label": "Mobile Y (%)", "min": 0, "max": 100, "step": 1, "default": 70 },

        { "type": "range", "id": "size", "label": "Size (px)", "min": 10, "max": 36, "step": 1, "default": 20 },
        { "type": "color", "id": "color", "label": "Color", "default": "#ff3b30" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.image--image-with-text.presets.name"
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "custom.overlay"
    ]
  }
}
{% endschema %}
